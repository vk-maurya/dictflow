# Normalize line endings: scripts must be LF everywhere.
*.sh text eol=lf
*.bash text eol=lf
*.ps1 text eol=crlf

# Rust / Node / config files: LF
*.rs text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf

# Binaries
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DictFlow",
  "version": "0.2.1",
  "identifier": "com.dictflow.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DictFlow",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "overlay",
        "title": "DictFlow Overlay",
        "url": "overlay.html",
        "width": 168,
        "height": 44,
        "visible": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true,
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": false,
      "showMenuOnLeftClick": false,
      "tooltip": "DictFlow — offline voice dictation"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "DictFlow",
    "copyright": "Copyright © 2026 DictFlow contributors (MIT)",
    "category": "Productivity",
    "shortDescription": "Offline voice dictation for Windows and macOS",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "12.0"
    }
  }
}
